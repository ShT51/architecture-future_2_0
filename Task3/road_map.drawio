        <mxCell id="v5PB7i1j8Lk4ir7wr3My-28" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;T3 - Постепенный переход с Camel на Kafka&lt;/font&gt;" style="shape=rect;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=5;rounded=0;" parent="1" vertex="1">
